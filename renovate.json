{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": false,
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true,
    "rebaseWhen": "auto"
  },
  "pip-compile": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)requirements(?:[.-]\\w+)?\\.txt$/"
    ],
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub Actions passed to custom retry action",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[\\t ]*action:[\\t ]*(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)@(?<currentValue>v?\\d+(?:\\.\\d+){0,2})[\\t ]*(?:#.*)?(?:\\n|$)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "github-actions"
    }
  ],
  "packageRules": [
    {
      "description": "Keep mutable upstream image tags reproducible while Renovate tracks new manifests",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "gcr.io/distroless/**",
        "linuxserver/tvheadend"
      ],
      "pinDigests": true
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "rebaseWhen": "auto"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "2 days"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "coollabsio/minio",
        "minio/minio"
      ],
      "versioning": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?:\\d{2})-(?:\\d{2})-(?:\\d{2})Z$"
    }
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 20,
  "rangeStrategy": "bump"
}
